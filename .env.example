# ==============================================================================
# Scout AI — Environment Variables Example
# ==============================================================================

# 1. Google Gemini API Key (Required)
# Generate from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 2. Qdrant Vector Database
# For Local Docker:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
#
# For Qdrant Cloud (Production on Render):
# QDRANT_URL=https://xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=scout_documents

# 3. Model Configuration
EMBEDDING_MODEL=models/gemini-embedding-001
LLM_MODEL=gemini-3.8-flash

# 4. Storage & Retrieval Parameters
DATA_DIR=data/documents
STORAGE_DIR=data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# 5. Cloudinary Storage Configuration (Store documents in cloud without repo files)
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively, use CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# 6. Admin Authentication & Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET_KEY=scout-ai-secure-admin-token-2026

# 7. CORS Configuration
# Comma-separated list of allowed origins, or * for open access
CORS_ORIGINS=*

# 8. Deployment Server Port (Render injects PORT dynamically; 8000 locally)
PORT=8000

